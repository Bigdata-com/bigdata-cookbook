    "    print(\"✅ API key configured\")\n",
    "    print(f\"✅ API Base URL: {session.api_base_url}\")\n",
    "except ValueError as e:\n",
    "    print(f\"❌ Authentication failed: {e}\")\n",
    "    print(\"   Please set BIGDATA_API_KEY in your .env file\")\n",
    "    session = None\n"
