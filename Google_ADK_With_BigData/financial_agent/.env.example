# Copy to financial_agent/.env or set in the shell.
# Google Gemini (Developer API) — required for chat + local FAISS embeddings
GOOGLE_API_KEY=
# Optional alternative env name supported by google.genai / LangChain:
# GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Bigdata.com MCP — required for the full integration demo (https://mcp.bigdata.com/)
BIGDATA_API_KEY=

# Tests / CI only — do not set for normal adk web runs
# FINANCIAL_AGENT_DATA_DIR=/absolute/path/to/writable/dir
# FINANCIAL_AGENT_SKIP_EMBED_WARMUP=1
