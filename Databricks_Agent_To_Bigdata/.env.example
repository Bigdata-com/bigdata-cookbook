# Bigdata.com API key — generate at https://platform.bigdata.com/api-keys
# In Databricks this is stored as a secret (scope: bigdata, key: api_key), NOT read
# from a .env file. This file is only for local experimentation outside Databricks.
BIGDATA_API_KEY=bd-your-key-here

# OpenAI API key — used to drive the agent's LLM (gpt-5.4). In Databricks this is stored
# as a secret (scope: bigdata, key: openai_api_key) and consumed by the AI Gateway
# external-model endpoint created in 00_setup.ipynb (see README.md's "Set up the agent's
# LLM" section). Only set here for local experimentation.
OPENAI_API_KEY=sk-your-openai-key-here

# Databricks workspace (only needed if you run any of the notebooks' code from a local
# machine via the Databricks CLI / SDK instead of inside the workspace).
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi-your-token-here
