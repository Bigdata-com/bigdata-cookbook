   "source": [
    "# Run searches on News, Filings, and Transcripts via the Bigdata REST +\n",
    "# smart-batching stack (replaces removed bigdata-research-tools search_by_companies)\n",
    "df_sentences_news = []\n",
    "df_sentences_filings = []\n",
    "df_sentences_transcripts = []\n",
    "\n",
    "scopes_config = [\n",
    "    (\"news\", df_sentences_news),\n",
    "    (\"filings\", df_sentences_filings),\n",
    "    (\"transcripts\", df_sentences_transcripts),\n",
    "]\n",
    "\n",
    "# Cost control: small chunk_percentage against real, billed API keys\n",
    "CHUNK_PERCENTAGE = 0.01\n",
    "\n",
    "for scope, df_list in scopes_config:\n",
    "    for focus in list_specific_focus:\n",
    "        theme_summaries = list(themes_tree_dict[focus].get_terminal_label_summaries().values())\n",
    "        df_sentences = run_universe_search(\n",
    "            company_ids=company_ids,\n",
    "            queries=theme_summaries,\n",
    "            start_date=start_date,\n",
    "            end_date=end_date,\n",
    "            scope=scope,\n",
    "            chunk_percentage=CHUNK_PERCENTAGE,\n",
    "            id_to_name=id_to_name,\n",
    "        )\n",
    "        if df_sentences.empty:\n",
    "            df_sentences = pd.DataFrame(columns=SEARCH_COLUMNS)\n",
    "        df_sentences['theme'] = general_theme + ' in ' + focus\n",
    "        df_list.append(df_sentences)\n",
    "\n",
    "# Concatenate results\n",
    "df_sentences_news = pd.concat(df_sentences_news, ignore_index=True) if df_sentences_news else pd.DataFrame(columns=SEARCH_COLUMNS)\n",
    "df_sentences_filings = pd.concat(df_sentences_filings, ignore_index=True) if df_sentences_filings else pd.DataFrame(columns=SEARCH_COLUMNS)\n",
    "df_sentences_transcripts = pd.concat(df_sentences_transcripts, ignore_index=True) if df_sentences_transcripts else pd.DataFrame(columns=SEARCH_COLUMNS)\n",
    "\n",
    "print(f\"news={len(df_sentences_news)} filings={len(df_sentences_filings)} transcripts={len(df_sentences_transcripts)}\")\n"
   ]
  },
