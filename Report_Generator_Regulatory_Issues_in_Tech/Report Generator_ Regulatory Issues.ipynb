   "source": [
    "# Generate the Theme Tree (plain OpenAI-based taxonomy; replaces the removed\n",
    "# bigdata-research-tools mindmap generator, same terminal-label/summary shape)\n",
    "themes_tree_dict = {}\n",
    "for focus in list_specific_focus:\n",
    "    theme_tree = generate_theme_tree(\n",
    "                        main_theme=general_theme,\n",
    "                        focus=focus\n",
    "                    )\n",
    "    themes_tree_dict[focus] = theme_tree\n",
    "\n",
    "# ThemeTree has no .visualize() (that was a bigdata-research-tools/graphviz\n",
    "# feature) — print the leaf labels + summaries instead.\n",
    "for focus, tree in themes_tree_dict.items():\n",
    "    print(f\"\\n=== {focus} ===\")\n",
    "    for label, summary in tree.get_terminal_label_summaries().items():\n",
    "        print(f\"- {label}: {summary}\")\n"
   ]
