    "id": "label-results"
   },
   "source": [
    "### Label the Results\n",
    "\n",
    "Use an LLM to analyze each document chunk and determine its relevance to the main theme. Any document chunks which aren't explicitly linked to **Regulatory Issues** will be filtered out."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-08-14T13:21:33.812556Z",
     "iopub.status.busy": "2026-08-14T13:21:33.812499Z",
     "iopub.status.idle": "2026-08-14T13:22:05.145761Z",
     "shell.execute_reply": "2026-08-14T13:22:05.145144Z"
    },
    "executionInfo": {
     "elapsed": 725940,
     "status": "ok",
     "timestamp": 1752233129401,
     "user": {
      "displayName": "Francesco Ricigliano",
      "userId": "07139234200501924124"
     },
     "user_tz": -120
    },
    "id": "labeling",
    "outputId": "53caec8a-5735-4938-b910-a13a2b5f95e2"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "labeled: news=20 filings=12 transcripts=8\n"
     ]
    }
   ],
   "source": [
    "# Label the search results with our theme labels\n",
    "labeler = SimpleLabeler(model=llm_model.split('::')[1], api_key=OPENAI_API_KEY)\n",
    "\n",
    "# Initialize empty lists for labeled data\n",
    "df_news_labeled = []\n",
    "df_filings_labeled = []\n",
    "df_transcripts_labeled = []\n",
    "\n",
    "# Configure data sources\n",
    "sources_config = [\n",
    "    (df_sentences_news, df_news_labeled),\n",
    "    (df_sentences_filings, df_filings_labeled),\n",
    "    (df_sentences_transcripts, df_transcripts_labeled),\n",
    "]\n",
    "\n",
    "# Cost control: cap OpenAI labeling calls per theme/scope combination\n",
    "MAX_ROWS_TO_LABEL = 10\n",
    "\n",
    "for df_sentences, labeled_list in sources_config:\n",
    "    for focus in list_specific_focus:\n",
    "        df_sentences_theme = df_sentences.loc[(df_sentences.theme == general_theme + ' in ' + focus)]\n",
    "        df_sentences_theme = df_sentences_theme.reset_index(drop=True).head(MAX_ROWS_TO_LABEL)\n",
    "        if df_sentences_theme.empty:\n",
    "            continue\n",
    "        df_labels = labeler.get_labels(\n",
    "            main_theme=general_theme + ' in ' + focus,\n",
    "            labels=list(themes_tree_dict[focus].get_terminal_label_summaries().keys()),\n",
    "            texts=df_sentences_theme[\"masked_text\"].tolist()\n",
    "        )\n",
    "        df_merged_labels = pd.merge(df_sentences_theme, df_labels, left_index=True, right_index=True)\n",
    "        labeled_list.append(df_merged_labels)\n",
    "\n",
    "# Concatenate results\n",
    "df_news_labeled = pd.concat(df_news_labeled, ignore_index=True) if df_news_labeled else pd.DataFrame(columns=LABEL_COLUMNS)\n",
    "df_filings_labeled = pd.concat(df_filings_labeled, ignore_index=True) if df_filings_labeled else pd.DataFrame(columns=LABEL_COLUMNS)\n",
    "df_transcripts_labeled = pd.concat(df_transcripts_labeled, ignore_index=True) if df_transcripts_labeled else pd.DataFrame(columns=LABEL_COLUMNS)\n",
    "\n",
    "print(f\"labeled: news={len(df_news_labeled)} filings={len(df_filings_labeled)} transcripts={len(df_transcripts_labeled)}\")\n"
   ]
  },
